{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenPlay",
  "version": "0.1.0",
  "identifier": "com.openplay.launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "title": "OpenPlay",
      "width": 1536,
      "height": 1024,
      "minWidth": 1050,
      "minHeight": 700,
      "resizable": true,
      "fullscreen": false
    }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "windows": { "nsis": { "installMode": "currentUser" } }
  }
}